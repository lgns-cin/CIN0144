    "def sort_by_range(values: list[str], *, is_float = False):\n",
    "    \"\"\"Ordena intervalos numéricos escritos por extenso\"\"\"\n",
    "\n",
    "    range_type = float if is_float else int\n",
    "    \n",
    "    ranges = sorted(\n",
    "        [range_type(v) for v in range[1:-1].split(', ')]\n",
    "        for range in values\n",
    "    )\n",
    "\n",
    "    return [\n",
    "        f'({a}, {b}]' for a, b in ranges\n",
    "    ]"
   ]
  },
