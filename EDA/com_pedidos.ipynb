    "#Como churn se desenha ao longo do tempo\n",
    "PALETA_CHURN = {0: '#6a00a8', 1: '#f89441'}\n",
    "ROTULO_CHURN = {0: 'Retido', 1: 'Churned'}\n",
    "\n",
    "offset = (dias_cliente['data'] - DATA_INI).dt.days\n",
    "dias_cliente['periodo'] = np.minimum(offset * N_PERIODOS_TRAJETORIA // N_DIAS, N_PERIODOS_TRAJETORIA - 1)\n",
    "\n",
    "por_periodo = (\n",
    "    pandas.crosstab(dias_cliente['id_cliente'], dias_cliente['periodo'])\n",
    "    .reindex(columns=range(N_PERIODOS_TRAJETORIA), fill_value=0)\n",
    "    .reindex(var_freq['id_cliente'], fill_value=0)\n",
    ")\n",
    "por_periodo['churned'] = var_freq.set_index('id_cliente')['churned']\n",
    "\n",
    "trajetoria_media = por_periodo.groupby('churned').mean().T\n",
    "inicio_periodo = [DATA_INI + pandas.Timedelta(days=int(np.ceil(i * N_DIAS / N_PERIODOS_TRAJETORIA))) for i in range(N_PERIODOS_TRAJETORIA)]\n",
    "rotulos = [d.strftime('%d/%m') for d in inicio_periodo]\n",
    "\n",
    "fig, ax = plot.subplots(figsize=(9, 4))\n",
    "for churned in (0, 1):\n",
    "    ax.plot(rotulos, trajetoria_media[churned], marker='o', color=PALETA_CHURN[churned],\n",
