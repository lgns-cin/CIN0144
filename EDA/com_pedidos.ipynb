   "source": [
    "### Bivariada: cadastro vs churn\n",
    "\n",
    "Variáveis categóricas (do cadastro) comparadas com o churn: taxa de churn de cada categoria e teste qui-quadrado. `p < 0,05` indica relação com o churn. "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 42,
   "id": "9e3e0249",
   "metadata": {},
   "outputs": [],
   "source": [
    "def analise_categorica(coluna, minimo=30):\n",
    "    serie = leads[coluna].astype(str)\n",
    "    contagem = serie.value_counts()\n",
    "    serie = serie.where(serie.map(contagem) >= minimo, 'Outras')     # categorias com poucos leads viram 'Outras'\n",
    "\n",
    "    # quantos leads e qual a taxa de churn de cada categoria\n",
    "    tabela = leads.groupby(serie)['churned'].agg(leads='count', taxa_churn='mean')\n",
    "    tabela['taxa_churn'] = (tabela['taxa_churn'] * 100).round(1)\n",
    "\n",
    "    # qui-quadrado\n",
    "    p = stats.chi2_contingency(pandas.crosstab(serie, leads['churned']))[1]\n",
    "    conclusao = 'há relação com o churn' if p < 0.05 else 'sem relação clara com o churn'\n",
    "    print(f'{coluna}: p-valor = {p:.4f} -> {conclusao}')\n",
    "\n",
    "    return tabela.sort_values('taxa_churn', ascending=False)"
   ]
  },
