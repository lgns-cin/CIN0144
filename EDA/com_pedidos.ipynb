    "#Tabela de Contingência\n",
    "print(\"=== TABELA CRUZADA (QUANTIDADE DE COMBINAÇÕES) ===\")\n",
    "tabela_cruzada = pandas.crosstab(pedidos['valor'], pedidos['produtos'])\n",
    "display(tabela_cruzada)\n",
    "\n",
    "#Correlação Matemática\n",
    "pedidos_analise = pedidos.copy()\n",
    "\n",
    "pedidos_analise['valor_num'] = pedidos_analise['valor'].apply(extrair_numero)\n",
    "pedidos_analise['produtos_num'] = pedidos_analise['produtos'].apply(extrair_numero)\n",
    "\n",
    "correlacao = pedidos_analise['valor_num'].corr(pedidos_analise['produtos_num'])\n",
    "\n",
    "print(\"\\n=== CORRELAÇÃO MATEMÁTICA ===\")\n",
    "print(f\"O índice de correlação entre Valor e Produtos é: {correlacao:.4f}\")"
   ]
