    "def extrair_numero(texto):\n",
    "    if pandas.isna(texto):\n",
    "        return np.nan\n",
    "    numeros = re.findall(r'\\d+', str(texto))\n",
    "    if len(numeros) == 2:\n",
    "        return (float(numeros[0]) + float(numeros[1])) / 2\n",
    "    return np.nan\n",
    "clientes_alvo = pedidos[pedidos['valor'].isna() | pedidos['produtos'].isna()]['id_cliente'].unique()\n",
    "pedidos_filtrados = pedidos[pedidos['id_cliente'].isin(clientes_alvo)].copy()\n",
    "pedidos_filtrados['valor_numerico'] = pedidos_filtrados['valor'].apply(extrair_numero)\n",
    "\n",
    "# Clientes que tem valores ou produtos faltando\n",
    "print(\"=== HISTÓRICO COMPLETO SEPARADO POR CLIENTE ===\")\n",
    "for id_cliente, dados_do_cliente in pedidos_filtrados.groupby('id_cliente'):\n",
    "    print(f\"\\n---> Mostrando todos os pedidos do Cliente ID: {id_cliente}\")\n",
    "    # Usamos o display para mostrar a tabela original bonitinha no notebook\n",
    "    display(dados_do_cliente[['id_pedido', 'id_cliente', 'valor', 'produtos', 'data_entrega']])"
   ]
  },
