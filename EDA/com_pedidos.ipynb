   "source": [
    "#faixa de total de pedidos\n",
    "BINS_PEDIDOS = [-1, 0, 1, 2, 4, 7, 12, np.inf]\n",
    "ROTULOS_PEDIDOS = ['0', '1', '2', '3-4', '5-7', '8-12', '13+']\n",
    "\n",
    "total_pedidos['faixa_pedidos'] = pandas.cut(total_pedidos['n_pedidos'], BINS_PEDIDOS, labels=ROTULOS_PEDIDOS)\n",
    "tab_ped = taxa_por_categoria(total_pedidos, 'faixa_pedidos', ROTULOS_PEDIDOS)\n",
    "display(tab_ped.assign(taxa_churn=(tab_ped['taxa_churn'] * 100).round(1)))\n",
    "\n",
    "p, v, esp_min = chi2_categorico(total_pedidos, 'faixa_pedidos')\n",
    "print(f'qui-quadrado: p = {p:.4g} | V de Cramér = {v:.3f} | menor frequência esperada = {esp_min:.1f}')\n",
    "\n",
    "# correlações: todos os leads x só quem pediu\n",
    "linhas = []\n",
    "for nome, base in [('todos os leads (inclui 0 pedidos)', total_pedidos), ('só clientes com pedido', total_pedidos[total_pedidos['n_pedidos'] > 0])]:\n",
    "    rho, p_rho = stats.spearmanr(base['n_pedidos'], base['churned'])\n",
    "    r_pb, p_pb = stats.pointbiserialr(base['churned'], base['n_pedidos'])\n",
    "    _, p_mw = stats.mannwhitneyu(base.loc[base.churned == 1, 'n_pedidos'], base.loc[base.churned == 0, 'n_pedidos'])\n",
    "    linhas.append({'base': nome, 'n': len(base), 'Spearman': rho, 'p (Spearman)': p_rho,\n",
    "                   'ponto-bisserial': r_pb, 'p (Mann-Whitney)': p_mw})\n",
    "display(pandas.DataFrame(linhas).set_index('base').round(4))\n",
    "\n",
    "fig, ax = plot.subplots(figsize=(10, 4.5))\n",
    "barras_taxa_churn(tab_ped, ax, 'Taxa de churn por faixa de total de pedidos', referencia=total_pedidos['churned'].mean())\n",
    "ax.set_xlabel('total de pedidos por cliente')\n",
    "seaborn.despine()\n",
    "plot.show()"
   ]
  }
 ],
