    "ax.set_title('Média de dias com pedido por cliente ao longo do período')\n",
    "ax.set_xlabel('início da fatia de tempo')\n",
    "ax.set_ylabel('dias com pedido (média)')\n",
    "ax.legend()\n",
    "seaborn.despine()\n",
