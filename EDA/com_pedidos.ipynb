    "def taxa_por_categoria(df, coluna, ordem=None):\n",
    "    tabela = df.groupby(coluna, observed=True)['churned'].agg(clientes='count', churn='sum', taxa_churn='mean')\n",
    "    return tabela.reindex(ordem).dropna(subset=['clientes']) if ordem is not None else tabela\n",
    "\n",
    "\n",
    "def chi2_categorico(df, coluna):\n",
    "    ct = pandas.crosstab(df[coluna], df['churned'])\n",
    "    ct = ct.loc[ct.sum(axis=1) > 0] # categorias sem nenhum cliente zerariam a frequência esperada\n",
    "    chi2, p, _, esperado = stats.chi2_contingency(ct)\n",
    "    n = ct.values.sum()\n",
    "    cramer_v = np.sqrt(chi2 / (n * (min(ct.shape) - 1)))\n",
    "    return p, cramer_v, esperado.min()\n",
    "\n",
    "\n",
    "def barras_taxa_churn(tabela, ax, titulo, referencia=None, rotacao=0):\n",
    "    # barras com a taxa de churn por categoria e o n de cada uma em cima\n",
    "    tabela = tabela.copy()\n",
    "    tabela.index = tabela.index.astype(str)\n",
    "    ax.bar(tabela.index, tabela['taxa_churn'], color=PALETA_CHURN[1])\n",
    "    for i, (n, taxa) in enumerate(zip(tabela['clientes'], tabela['taxa_churn'])):\n",
    "        ax.text(i, taxa + 0.01, f'{taxa:.0%}\\nn={int(n)}', ha='center', va='bottom', fontsize=9)\n",
    "    if referencia is not None:\n",
    "        ax.axhline(referencia, color='gray', linestyle='--', label=f'média geral ({referencia:.0%})')\n",
    "        ax.legend(loc='upper right')\n",
    "    ax.set_ylim(0, min(1.15, tabela['taxa_churn'].max() + 0.2))\n",
    "    ax.set_title(titulo)\n",
    "    ax.set_ylabel('taxa de churn')\n",
    "    ax.set_xlabel('')\n",
    "    ax.tick_params(axis='x', rotation=rotacao)\n",
    "\n",
    "\n",
    "taxa_geral = var_freq['churned'].mean()\n",
    "tab_traj = taxa_por_categoria(var_freq, 'trajetoria', ORDEM_TRAJETORIA)\n",
    "display(tab_traj.assign(taxa_churn=(tab_traj['taxa_churn'] * 100).round(1)))\n",
    "\n",
    "p, v, esp_min = chi2_categorico(var_freq, 'trajetoria')\n",
    "print(f'qui-quadrado: p = {p:.4g} | V de Cramér = {v:.3f} | menor frequência esperada = {esp_min:.1f}'\n",
    "      + ('  (atenção: < 5, interprete com cautela)' if esp_min < 5 else ''))\n",
    "\n",
    "fig, ax = plot.subplots(figsize=(10, 4.5))\n",
    "barras_taxa_churn(tab_traj, ax, 'Taxa de churn por trajetória de frequência de compra', referencia=taxa_geral)\n",
    "seaborn.despine()\n",
    "plot.show()"
   ]
  },
