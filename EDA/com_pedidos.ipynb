    "# tratamento dos 3 nulos encontrados\n",
    "nulos = pedidos['valor_num'].isna() | pedidos['produtos_num'].isna()\n",
    "print('ANTES:')\n",
    "display(pedidos.loc[nulos, ['id_pedido', 'id_cliente', 'valor_num', 'produtos_num']])\n",
    "\n",
    "for coluna in ['valor_num', 'produtos_num']:\n",
    "    # devolve a mediana do cliente dela\n",
    "    mediana_do_cliente = pedidos.groupby('id_cliente')[coluna].transform('median')\n",
    "    pedidos[coluna] = pedidos[coluna].fillna(mediana_do_cliente).fillna(pedidos[coluna].median())\n",
    "\n",
    "print('DEPOIS:')\n",
    "display(pedidos.loc[nulos, ['id_pedido', 'id_cliente', 'valor_num', 'produtos_num']])"
   ]
