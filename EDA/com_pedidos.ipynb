   "source": [
    "def get_frequencia_pedido(cliente: int) -> float:\n",
    "    pedidos_do_cliente = pedidos[pedidos.id_cliente == cliente]\n",
    "    \n",
    "    if pedidos_do_cliente.empty:\n",
    "        return -np.inf # se o cliente nunca pediu nada antes\n",
    "\n",
    "    pedidos_do_cliente.data_entrega = pedidos_do_cliente.data_entrega.apply(pandas.to_datetime)\n",
    "\n",
    "    datas = sorted(pedidos_do_cliente.data_entrega)\n",
    "    deltas = []\n",
    "    \n",
    "    for i in range(len(datas) - 1, 0, -1):\n",
    "        delta = datas[i] - datas[i - 1]\n",
    "        deltas.append(delta.days)\n",
    "\n",
    "    # se é o primeiro pedido do cliente isso vai ser 0 pq nao vai ter deltas\n",
    "    return np.average(deltas) if len(deltas) > 0 else 0.0\n",
    "\n",
    "for cliente in joined.id_cliente.unique():\n",
    "    joined.loc[joined.id_cliente == cliente, 'frequencia_compras'] = get_frequencia_pedido(cliente)\n",
    "\n",
    "joined.frequencia_compras"
   ]
  },
