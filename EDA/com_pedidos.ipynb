    "\n",
    "fig, axes = plot.subplots(1, 3, figsize=(18, 4))\n",
    "for ax, coluna, titulo in [(axes[0], 'faixa_recencia', 'Churn por recência (dias desde o último pedido)'),\n",
    "                           (axes[1], 'faixa_pedidos', 'Churn por nº de pedidos'),\n",
    "                           (axes[2], 'faixa_dias', 'Churn por nº de dias com pedido')]:\n",
    "    tabela = com_pedido.groupby(coluna, observed=True)['churned'].agg(n='count', taxa='mean')\n",
    "    tabela['taxa'].plot(kind='bar', ax=ax, rot=0)\n",
    "    ax.axhline(leads['churned'].mean(), color='gray', linestyle='--')    # linha tracejada = taxa geral dos leads\n",
    "    for i, (n, taxa) in enumerate(zip(tabela['n'], tabela['taxa'])):\n",
    "        ax.text(i, taxa + 0.01, f'n={n}', ha='center')\n",
    "    ax.set_title(titulo)\n",
    "    ax.set_xlabel('')\n",
    "    ax.set_ylabel('taxa de churn')\n",
    "plot.tight_layout()\n",
