    "\n",
    "MIN_DIAS_COM_PEDIDO = 2 #pra poder analisar variação\n",
    "LIMIAR_ESTAVEL = 0.2 # |variacao_idx| abaixo disso = 'Estável'\n",
    "N_PERIODOS_TRAJETORIA = 6 #nº de fatias de tempo no gráfico de trajetória\n",
    "\n",
    "pedidos['data'] = pandas.to_datetime(pedidos['data_entrega'])\n",
    "DATA_INI, DATA_FIM = pedidos['data'].min(), pedidos['data'].max()\n",
    "N_DIAS = (DATA_FIM - DATA_INI).days + 1\n",
    "CORTE = DATA_INI + pandas.Timedelta(days=N_DIAS // 2) #divide o período ao meio\n",
    "\n",
    "dias_cliente = (\n",
    "    pedidos[['id_cliente', 'data']]\n",
    "    .drop_duplicates()\n",
    "    .sort_values(['id_cliente', 'data'])\n",
    "    .reset_index(drop=True)\n",
    ")\n",
    "dias_cliente['janela'] = np.where(dias_cliente['data'] < CORTE, 'inicio', 'fim')\n",
    "\n",
    "print(f'período: {DATA_INI.date()} -> {DATA_FIM.date()} ({N_DIAS} dias) | corte: {CORTE.date()}')\n",
    "\n",
    "freq_janela = (\n",
    "    pandas.crosstab(dias_cliente['id_cliente'], dias_cliente['janela'])\n",
    "    .reindex(columns=['inicio', 'fim'], fill_value=0)\n",
    "    .rename(columns={'inicio': 'dias_inicio', 'fim': 'dias_fim'})\n",
    "    .rename_axis(columns=None)\n",
    ")\n",
    "freq_janela['n_dias'] = freq_janela['dias_inicio'] + freq_janela['dias_fim']\n",
    "freq_janela['variacao_abs'] = freq_janela['dias_fim'] - freq_janela['dias_inicio']\n",
    "freq_janela['variacao_idx'] = freq_janela['variacao_abs'] / freq_janela['n_dias']\n",
    "\n",
    "linhas = []\n",
    "for id_cliente, datas in dias_cliente.groupby('id_cliente')['data']:\n",
    "    intervalos = datas.diff().dropna().dt.days.to_numpy()\n",
    "    k = len(intervalos)\n",
    "    if k >= 2:\n",
    "        m = k // 2 \n",
    "        ini, fim = intervalos[:m].mean(), intervalos[-m:].mean()\n",
    "    else:\n",
    "        ini = fim = np.nan\n",
    "    linhas.append({'id_cliente': id_cliente, 'intervalo_inicial': ini, 'intervalo_final': fim})\n",
    "\n",
    "intervalos_cliente = pandas.DataFrame(linhas)\n",
    "intervalos_cliente['aceleracao_dias'] = intervalos_cliente['intervalo_inicial'] - intervalos_cliente['intervalo_final']\n",
    "\n",
    "#linha por cliente (apenas quem tem pedidos)\n",
    "var_freq = (\n",
    "    base_clientes.loc[base_clientes['tem_pedido'] == 1, ['id_cliente', 'churned']]\n",
    "    .merge(freq_janela.reset_index(), on='id_cliente', how='left', validate='one_to_one')\n",
    "    .merge(intervalos_cliente, on='id_cliente', how='left', validate='one_to_one')\n",
    ")\n",
    "\n",
