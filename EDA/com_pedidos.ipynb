   "source": [
    "# '(0, 500]' -> 250\n",
    "def ponto_medio_pedido(faixa):\n",
    "    if pandas.isna(faixa):\n",
    "        return np.nan\n",
    "    baixo, alto = [float(x) for x in faixa.strip('()[]').split(',')]\n",
    "    if alto >= 10_000_000:        # o teto não significa nada\n",
    "        return baixo              # usa o limite inferior\n",
    "    return (baixo + alto) / 2     # faixa fechada - ponto medio\n",
    "\n",
    "pedidos['valor_num'] = pedidos['valor'].map(ponto_medio_pedido)\n",
    "pedidos['produtos_num'] = pedidos['produtos'].map(ponto_medio_pedido)\n",
    "\n",
    "display(pedidos[['valor', 'valor_num']].drop_duplicates().sort_values('valor_num'))\n",
    "display(pedidos[['produtos', 'produtos_num']].drop_duplicates().sort_values('produtos_num'))\n"
   ]
  },
