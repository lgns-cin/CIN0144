    "def testes_variacao(df, coluna):\n",
    "    d = df[[coluna, 'churned']].dropna()\n",
    "    ret, chu = d.loc[d.churned == 0, coluna], d.loc[d.churned == 1, coluna]\n",
    "    rho, p_rho = stats.spearmanr(d[coluna], d['churned'])\n",
    "    r_pb, p_pb = stats.pointbiserialr(d['churned'], d[coluna])\n",
    "    _, p_mw = stats.mannwhitneyu(chu, ret)\n",
    "    return {'variável': coluna, 'n': len(d),\n",
    "            'mediana (retido)': ret.median(), 'mediana (churned)': chu.median(),\n",
    "            'Spearman': rho, 'p (Spearman)': p_rho,\n",
    "            'ponto-bisserial': r_pb, 'p (Mann-Whitney)': p_mw}\n",
    "\n",
    "\n",
    "resumo_corr = pandas.DataFrame([\n",
    "    testes_variacao(var_freq, 'variacao_abs'),\n",
    "    testes_variacao(var_freq, 'variacao_idx'),\n",
    "    testes_variacao(var_freq, 'aceleracao_dias'),\n",
    "]).set_index('variável')\n",
    "display(resumo_corr.round(4))"
   ]
  },
