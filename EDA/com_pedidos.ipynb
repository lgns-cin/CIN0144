    "from numpy import nan, average\n",
    "\n",
    "def pegar_media(intervalo: str) -> float:\n",
    "    if not isinstance(intervalo, str):\n",
    "        return nan\n",
    "    a, b = intervalo[1:-1].split(', ')\n",
    "    return 0.5*(float(a)+float(b))\n",
    "\n",
    "joined['produtos_media'] = joined.produtos.apply(pegar_media)\n",
    "\n",
    "medias_produto_por_cliente = joined.get(['id_cliente', 'produtos_media', 'churned']).groupby('id_cliente').aggregate(average)\n",
    "\n",
    "seaborn.displot(data=medias_produto_por_cliente, x='produtos_media', hue='churned', kind='kde')"
   ]
