    "# a transição em si da frequência\n",
    "FAIXAS_INTERVALO = [0, 7, 15, np.inf]\n",
    "ROTULOS_INTERVALO = ['semanal (≤7d)', 'quinzenal (8-15d)', 'mensal+ (>15d)']\n",
    "\n",
    "recorrentes = var_freq.dropna(subset=['intervalo_inicial', 'intervalo_final']).copy()\n",
    "recorrentes['ritmo_inicial'] = pandas.cut(recorrentes['intervalo_inicial'], FAIXAS_INTERVALO, labels=ROTULOS_INTERVALO)\n",
    "recorrentes['ritmo_final'] = pandas.cut(recorrentes['intervalo_final'], FAIXAS_INTERVALO, labels=ROTULOS_INTERVALO)\n",
    "\n",
    "agrupado = recorrentes.groupby(['ritmo_inicial', 'ritmo_final'], observed=False)['churned'].agg(['mean', 'count'])\n",
    "taxa_mx = agrupado['mean'].unstack()\n",
    "n_mx = agrupado['count'].unstack().fillna(0).astype(int)\n",
    "\n",
    "anotacoes = np.empty(taxa_mx.shape, dtype=object)\n",
    "for i in range(taxa_mx.shape[0]):\n",
    "    for j in range(taxa_mx.shape[1]):\n",
    "        anotacoes[i, j] = '' if n_mx.iat[i, j] == 0 else f'{taxa_mx.iat[i, j]:.0%}\\n(n={n_mx.iat[i, j]})'\n",
    "\n",
    "fig, ax = plot.subplots(figsize=(8, 5))\n",
    "seaborn.heatmap(taxa_mx, annot=anotacoes, fmt='', cmap='plasma_r', vmin=0, vmax=1, mask=taxa_mx.isna(),\n",
    "                linewidths=0.5, cbar_kws={'label': 'taxa de churn'}, ax=ax)\n",
    "ax.set_title('Taxa de churn por transição de ritmo de compra')\n",
    "ax.set_xlabel('ritmo FINAL (últimos intervalos)')\n",
    "ax.set_ylabel('ritmo INICIAL (primeiros intervalos)')\n",
    "plot.show()\n",
    "\n",
    "# resumo: quem desacelerou x manteve x acelerou de faixa\n",
    "nivel = {r: i for i, r in enumerate(ROTULOS_INTERVALO)}\n",
    "dif = recorrentes['ritmo_final'].map(nivel).astype(int) - recorrentes['ritmo_inicial'].map(nivel).astype(int)\n",
    "recorrentes['mudanca_de_ritmo'] = np.select([dif > 0, dif < 0], ['Desacelerou (mudou p/ faixa mais lenta)', 'Acelerou (mudou p/ faixa mais rápida)'], 'Manteve a faixa')\n",
    "display(taxa_por_categoria(recorrentes, 'mudanca_de_ritmo').assign(taxa_churn=lambda d: (d['taxa_churn'] * 100).round(1)))"
