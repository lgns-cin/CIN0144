    "           'produtos_mediano', 'produtos_medio', 'produtos_max', 'recencia_dias', 'intervalo_medio_dias']\n",
    "\n",
    "# Spearman de cada variável com o churn\n",
    "# positivo - quanto maior a variável, mais churn | negativo - quanto maior a variável, menos churn\n",
    "linhas = []\n",
    "for coluna in colunas:\n",
    "    dados = com_pedido[[coluna, 'churned']].dropna()\n",
    "    rho, p = stats.spearmanr(dados[coluna], dados['churned'])\n",
    "    linhas.append({'variável': coluna, 'n': len(dados), 'Spearman': rho, 'p-valor': p})\n",
    "\n",
    "seaborn.heatmap(data=base_clientes[colunas + ['churned']].corr(method='spearman'), annot=True, fmt='.2f')\n",
    "pandas.DataFrame(linhas).set_index('variável').sort_values('Spearman', key=abs, ascending=False).round(3)"
   ]
