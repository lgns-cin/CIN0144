    "análise da coluna 'produto' e 'valor' discretizando o intervalos que existem em cada uma para fazer uma análise categórica de ambas individualmente com o fato de terem dado churned ou não"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 72,
   "id": "ac9275dc",
   "metadata": {},
   "outputs": [],
   "source": [
    "def faixas_por_cliente(coluna):\n",
    "    # ordem natural das faixas, do menor para o maior intervalo (usa o helper sort_by_range definido acima)\n",
    "    ordem = sort_by_range(pedidos[coluna].dropna().unique())\n",
    "    tipo = pandas.CategoricalDtype(ordem, ordered=True)\n",
    "\n",
    "    ped = pedidos[['id_cliente', coluna]].dropna().copy()\n",
    "    ped[coluna] = ped[coluna].astype(tipo)\n",
    "\n",
    "    contagem = pandas.crosstab(ped['id_cliente'], ped[coluna]).reindex(columns=ordem)\n",
    "    # moda com empate -> faixa maior: inverte as colunas para o idxmax pegar a última em caso de empate\n",
    "    moda = contagem.iloc[:, ::-1].idxmax(axis=1)\n",
    "    maxima = ped.groupby('id_cliente', observed=True)[coluna].max()\n",
    "\n",
    "    return ordem, tipo, contagem, moda.astype(tipo), maxima.astype(tipo)\n",
    "\n",
    "\n",
    "def analise_faixa_cliente(coluna, rotulo):\n",
    "    ordem, tipo, contagem, moda, maxima = faixas_por_cliente(coluna)\n",
    "\n",
    "    clientes = base_clientes.loc[base_clientes['tem_pedido'] == 1, ['id_cliente', 'churned']].set_index('id_cliente')\n",
    "    clientes = clientes.join(moda.rename('faixa_moda')).join(maxima.rename('faixa_maxima')).dropna()\n",
    "    referencia = clientes['churned'].mean()\n",
    "\n",
    "    fig, axes = plot.subplots(1, 2, figsize=(16, 4.5))\n",
    "    for ax, col, titulo in [(axes[0], 'faixa_moda', f'faixa de {rotulo.lower()} mais frequente do cliente'),\n",
    "                            (axes[1], 'faixa_maxima', f'maior faixa de {rotulo.lower()} já atingida pelo cliente')]:\n",
    "        clientes[col] = clientes[col].astype(tipo)\n",
    "        tabela = taxa_por_categoria(clientes, col, ordem)\n",
    "        p, v, esp_min = chi2_categorico(clientes, col)\n",
    "        aviso = '  (atenção: frequência esperada < 5 em alguma faixa)' if esp_min < 5 else ''\n",
    "        print(f'[{rotulo}] {titulo}: p = {p:.4g} | V de Cramér = {v:.3f}{aviso}')\n",
    "        display(tabela.assign(taxa_churn=(tabela['taxa_churn'] * 100).round(1)))\n",
    "        barras_taxa_churn(tabela, ax, f'Churn por {titulo}', referencia=referencia)\n",
    "    seaborn.despine()\n",
    "    plot.tight_layout()\n",
    "    plot.show()\n",
    "\n",
    "    # \"já fez pelo menos um pedido nessa faixa?\"\n",
    "    linhas = []\n",
    "    base = clientes.join(contagem)\n",
    "    for faixa in ordem:\n",
    "        fez = base[faixa] > 0\n",
    "        linhas.append({'faixa': faixa,\n",
    "                       'clientes que já pediram': int(fez.sum()),\n",
    "                       'churn (já pediu)': base.loc[fez, 'churned'].mean(),\n",
    "                       'churn (nunca pediu)': base.loc[~fez, 'churned'].mean()})\n",
    "    display(pandas.DataFrame(linhas).set_index('faixa').round(3))"
   ]
  },
