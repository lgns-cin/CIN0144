    "    ['Parou de comprar', 'Começou a comprar', 'Comprou menos', 'Comprou mais'],\n",
    "    default='Estável',\n",
    ")\n",
    "var_freq['trajetoria'] = pandas.Categorical(var_freq['trajetoria'], categories=ORDEM_TRAJETORIA, ordered=True)\n",
    "\n",
    "print(f\"clientes analisados: {len(var_freq)} | com variação de intervalo calculável (≥ 3 dias com pedido): {var_freq['aceleracao_dias'].notna().sum()}\")\n",
