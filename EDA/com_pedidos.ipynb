   "source": [
    "total_pedidos = base_clientes[['id_cliente', 'churned', 'n_pedidos']].copy()\n",
    "total_pedidos['n_pedidos'] = total_pedidos['n_pedidos'].fillna(0).astype(int)      # sem pedido = 0\n",
    "total_pedidos['status'] = total_pedidos['churned'].map(ROTULO_CHURN)\n",
    "\n",
    "display(total_pedidos.groupby('status')['n_pedidos'].describe().round(2))\n",
    "\n",
    "fig, axes = plot.subplots(1, 3, figsize=(20, 4.5))\n",
    "cores = {ROTULO_CHURN[k]: c for k, c in PALETA_CHURN.items()}\n",
    "\n",
    "seaborn.ecdfplot(data=total_pedidos, x='n_pedidos', hue='status', palette=cores, hue_order=['Retido', 'Churned'], ax=axes[0])\n",
    "axes[0].set_xscale('symlog')\n",
    "axes[0].set_title('Distribuição acumulada do total de pedidos (escala log)')\n",
    "axes[0].set_xlabel('total de pedidos por cliente')\n",
    "\n",
    "seaborn.boxplot(data=total_pedidos, x='status', y='n_pedidos', hue='status', palette=cores, order=['Retido', 'Churned'], legend=False, ax=axes[1])\n",
    "axes[1].set_yscale('symlog')\n",
    "axes[1].set_title('Total de pedidos por status (escala log)')\n",
    "axes[1].set_xlabel('')\n",
    "\n",
    "# taxa de churn para cada contagem exata (agrupando a cauda em TETO+)\n",
    "TETO = 15\n",
    "exata = total_pedidos.assign(n_exato=total_pedidos['n_pedidos'].clip(upper=TETO))\n",
    "curva = exata.groupby('n_exato')['churned'].agg(clientes='count', taxa='mean')\n",
    "axes[2].plot(curva.index, curva['taxa'], marker='o', color=PALETA_CHURN[1])\n",
    "axes[2].scatter(curva.index, curva['taxa'], s=curva['clientes'] / curva['clientes'].max() * 600, alpha=0.3, color=PALETA_CHURN[0])\n",
    "axes[2].axhline(total_pedidos['churned'].mean(), color='gray', linestyle='--')\n",
    "axes[2].set_xticks(curva.index, [str(i) if i < TETO else f'{TETO}+' for i in curva.index])\n",
    "axes[2].set_title('Taxa de churn por nº exato de pedidos (tamanho da bolha = nº de clientes)')\n",
    "axes[2].set_xlabel('total de pedidos por cliente')\n",
    "axes[2].set_ylabel('taxa de churn')\n",
    "seaborn.despine()\n",
    "plot.tight_layout()\n",
    "plot.show()"
   ]
  },
