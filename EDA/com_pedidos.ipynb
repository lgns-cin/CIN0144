   "source": [
    "DATA_REF = pedidos['data'].max()\n",
    "\n",
    "def intervalo_medio(datas):\n",
    "    dias = datas.drop_duplicates().sort_values()     # só dias distintos, em ordem\n",
    "    return dias.diff().dt.days.mean()                # diferença entre dias seguidos, em média (NaN se só há 1 dia)\n",
    "\n",
    "# agrupa os pedidos por cliente e calcula vários resumos de uma vez\n",
    "por_cliente = pedidos.groupby('id_cliente').agg(\n",
    "    n_pedidos=('id_pedido', 'count'),\n",
    "    n_dias_com_pedido=('data', 'nunique'),\n",
    "    valor_min=('valor_num', 'min'),\n",
    "    valor_medio=('valor_num', 'mean'),\n",
    "    valor_mediano=('valor_num', 'median'),\n",
    "    valor_max=('valor_num', 'max'),\n",
    "    produtos_min=('produtos_num', 'min'),\n",
    "    produtos_medio=('produtos_num', 'mean'),\n",
    "    produtos_mediano=('produtos_num', 'median'),\n",
    "    produtos_max=('produtos_num', 'max'),\n",
    "    ultima_data=('data', 'max'),\n",
    ")\n",
    "\n",
    "por_cliente['recencia_dias'] = (DATA_REF - por_cliente['ultima_data']).dt.days\n",
    "por_cliente['intervalo_medio_dias'] = pedidos.groupby('id_cliente')['data'].apply(intervalo_medio)\n",
    "por_cliente = por_cliente.drop(columns='ultima_data').reset_index()\n",
    "\n",
    "print('linhas:', len(por_cliente), '| clientes distintos:', por_cliente['id_cliente'].nunique())\n",
    "por_cliente.head(10)"
   ]
  },
