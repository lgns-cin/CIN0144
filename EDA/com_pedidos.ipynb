   "source": [
    "# Variação x churn CONTROLANDO por recência\n",
    "var_rec = var_freq.merge(base_clientes[['id_cliente', 'recencia_dias']], on='id_cliente', how='left', validate='one_to_one')\n",
    "\n",
    "FAIXAS_RECENCIA = [-1, 15, 30, 60, np.inf]\n",
    "ROTULOS_RECENCIA = ['0-15d', '16-30d', '31-60d', '61d+']\n",
    "var_rec['faixa_recencia'] = pandas.cut(var_rec['recencia_dias'], FAIXAS_RECENCIA, labels=ROTULOS_RECENCIA)\n",
    "\n",
    "#se o sinal era só recência, o Spearman fica perto de 0 em cada faixa\n",
    "linhas = []\n",
    "for faixa, d in var_rec.groupby('faixa_recencia', observed=True):\n",
    "    if len(d) < 30 or d['churned'].nunique() < 2 or d['variacao_idx'].nunique() < 2:\n",
    "        linhas.append({'faixa_recencia': faixa, 'n': len(d), 'taxa_churn': d['churned'].mean(), 'Spearman': np.nan, 'p-valor': np.nan})\n",
    "        continue\n",
    "    rho, p = stats.spearmanr(d['variacao_idx'], d['churned'])\n",
    "    linhas.append({'faixa_recencia': faixa, 'n': len(d), 'taxa_churn': d['churned'].mean(), 'Spearman': rho, 'p-valor': p})\n",
    "display(pandas.DataFrame(linhas).set_index('faixa_recencia').round(4))\n",
    "\n",
    "#correlação variação x churn removendo o efeito linear da recência (nos ranks)\n",
    "ranks = var_rec[['variacao_idx', 'churned', 'recencia_dias']].rank()\n",
    "def residuos(y, x):\n",
    "    return y - np.polyval(np.polyfit(x, y, 1), x)\n",
    "\n",
    "rho_bruto = stats.spearmanr(var_rec['variacao_idx'], var_rec['churned'])[0]\n",
    "rho_parcial = np.corrcoef(residuos(ranks['variacao_idx'], ranks['recencia_dias']),\n",
    "                          residuos(ranks['churned'], ranks['recencia_dias']))[0, 1]\n",
    "n = len(ranks)\n",
    "t = rho_parcial * np.sqrt((n - 3) / (1 - rho_parcial ** 2))\n",
    "p_parcial = 2 * stats.t.sf(abs(t), n - 3)\n",
    "print(f'Spearman bruto (variação x churn):           {rho_bruto:+.3f}')\n",
    "print(f'Spearman parcial (controlando a recência):   {rho_parcial:+.3f} | p = {p_parcial:.4g}')\n",
    "print('  -> se o parcial for bem menor (em módulo) que o bruto, a variação era em boa parte recência')\n",
    "\n",
    "#Taxa de churn por sinal da variação, dentro de cada faixa de recência\n",
    "display(var_rec.groupby(['faixa_recencia', 'sinal_variacao'], observed=True)['churned']\n",
    "        .agg(clientes='count', taxa_churn='mean').round(3))\n",
    "\n",
    "fig, ax = plot.subplots(figsize=(10, 4.5))\n",
    "seaborn.barplot(data=var_rec, x='faixa_recencia', y='churned', hue='sinal_variacao',\n",
    "                order=ROTULOS_RECENCIA, errorbar=None, ax=ax)\n",
    "ax.set_title('Taxa de churn por sinal da variação, dentro de cada faixa de recência')\n",
    "ax.set_xlabel('recência (dias desde o último pedido)')\n",
    "ax.set_ylabel('taxa de churn')\n",
    "ax.legend(title='variação')\n",
    "seaborn.despine()\n",
    "plot.show()"
   ]
