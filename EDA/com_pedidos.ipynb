    "base_clientes = leads.merge(por_cliente, on='id_cliente', how='left', validate='one_to_one')\n",
    "\n",
    "# flag - lead tem pedido ?\n",
    "base_clientes['tem_pedido'] = base_clientes['n_pedidos'].notna().astype(int)\n",
    "\n",
    "assert len(base_clientes) == len(leads)        # associa o conjunto de pedidos a um cliente - msm qnt de linhas agr\n",
    "print('linhas em base_clientes:', len(base_clientes), '| taxa de churn:', round(base_clientes['churned'].mean(), 3))\n",
    "print('clientes com pedido:', base_clientes['tem_pedido'].sum(), 'de', len(base_clientes))\n",
    "\n",
    "# só os clientes com pedido\n",
    "com_pedido = base_clientes[base_clientes['tem_pedido'] == 1]\n"
   ]
